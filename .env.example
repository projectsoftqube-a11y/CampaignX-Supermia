# Public site URL used for canonical + Open Graph absolute URLs.
NEXT_PUBLIC_SITE_URL=https://campaignx.supermia.ai

# Origin of the CampaignX billing API (no trailing slash).
# The pricing section calls `${BILLING_API_BASE_URL}/api/plans`.
# Server-only: not exposed to the browser. Without it the pricing section
# falls back to the static plans in the content config.
BILLING_API_BASE_URL=https://campaignxapi.supermia.ai

# Origin of the public API, used by the browser for the Contact Sales form
# (POST /api/plans/contact-sales). That endpoint needs no auth.
# Public by design: this value ships to the browser, so it must be reachable
# from a visitor's machine. Usually the same origin as BILLING_API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=https://campaignxapi.supermia.ai
